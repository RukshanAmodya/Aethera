<mjml>
	<mj-include path="./_common.mjml" />
	<mj-body>
		<mj-section padding="0 20px">
			<mj-column>
				<mj-include path="./_logo.mjml" />
				<mj-text font-size="20px" font-weight="700" color="#dc2626">⚠️ Workflow Error Alert</mj-text>
				<mj-text font-size="16px" color="#334155">Hi {{firstName}},</mj-text>
				<mj-text font-size="16px" color="#334155">Your workflow <b>"{{workflowName}}"</b> encountered an execution error.</mj-text>
				<mj-text font-size="15px" color="#475569">You can inspect the execution log and diagnose the error using the button below:</mj-text>
				<mj-button href="{{workflowUrl}}">Inspect Workflow Execution</mj-button>
				<mj-text font-size="14px" color="#64748b">Happy automating,<br /><b>The Aethera Team</b></mj-text>
				<mj-include path="./_footer.mjml" />
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
