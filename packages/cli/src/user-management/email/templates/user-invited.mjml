<mjml>
	<mj-include path="./_common.mjml" />
	<mj-body>
		<mj-section padding="0 20px">
			<mj-column>
				<mj-include path="./_logo.mjml" />
				<mj-text font-size="22px" font-weight="700" color="#0f172a">Welcome to Aethera! 🎉</mj-text>
				<mj-text font-size="16px" color="#334155">You have been invited to join Aethera at <b>{{domain}}</b>.</mj-text>
				<mj-text font-size="16px" color="#334155">To accept the invitation and activate your workspace, please click the button below.</mj-text>
				<mj-button href="{{inviteAcceptUrl}}">Set up your Aethera account</mj-button>
				<mj-include path="./_footer.mjml" />
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
