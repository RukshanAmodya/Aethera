<mjml>
	<mj-include path="./_common.mjml" />
	<mj-body>
		<mj-section padding="0 20px">
			<mj-column>
				<mj-include path="./_logo.mjml" />
				<mj-text font-size="22px" font-weight="700" color="#0f172a">A workflow has been shared with you</mj-text>
				<mj-text font-size="16px" color="#334155"><b>"{{ workflowName }}"</b> workflow has been shared with you on Aethera.</mj-text>
				<mj-text font-size="16px" color="#334155">To view or edit it, please click the button below:</mj-text>
				<mj-button href="{{workflowUrl}}">Open Workflow</mj-button>
				<mj-include path="./_footer.mjml" />
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
