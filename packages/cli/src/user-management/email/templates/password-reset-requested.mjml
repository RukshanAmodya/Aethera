<mjml>
	<mj-include path="./_common.mjml" />
	<mj-body>
		<mj-section padding="0 20px">
			<mj-column>
				<mj-include path="./_logo.mjml" />
				<mj-text font-size="22px" font-weight="700" color="#0f172a">Reset your Aethera password</mj-text>
				<mj-text font-size="16px" color="#334155">Hi {{firstName}},</mj-text>
				<mj-text font-size="16px" color="#334155">Somebody requested a password reset for your Aethera account on <b>{{domain}}</b>.</mj-text>
				<mj-text font-size="16px" color="#334155">Click the button below to choose a new password.</mj-text>
				<mj-button href="{{passwordResetUrl}}">Set a new password</mj-button>
				<mj-text font-size="13px" color="#64748b" font-style="italic">
					This password reset link is valid for 20 minutes. If you did not make this request, you can safely disregard this email. Your password will remain unchanged.
				</mj-text>
				<mj-include path="./_footer.mjml" />
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
